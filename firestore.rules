rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User Profile Document
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User Workouts Subcollection
      match /workouts/{workoutId} {
        allow read, write: if isOwner(userId);
      }

      // User Nutrition Subcollection
      match /nutrition/{dateId} {
        allow read, write: if isOwner(userId);
      }

      // User Body Measurements Subcollection
      match /measurements/{measurementId} {
        allow read, write: if isOwner(userId);
      }

      // User Steps Subcollection
      match /steps/{dateId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
